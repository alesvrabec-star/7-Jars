{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email"]
    },
    "Jar": {
      "title": "Jar",
      "description": "One of the 7 jars representing a budget category and balance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "shortName": { "type": "string" },
        "percentage": { "type": "number" },
        "balance": { "type": "number" },
        "purpose": { "type": "string" },
        "description": { "type": "string" },
        "goldenRule": { "type": "string" },
        "examples": { "type": "array", "items": { "type": "string" } },
        "icon": { "type": "string" },
        "theme": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "percentage", "balance"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Income, expense, or transfer log item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["income", "expense", "transfer"] },
        "jarId": { "type": "string" },
        "toJarId": { "type": "string" },
        "category": { "type": "string" },
        "note": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "date", "amount", "type", "jarId"]
    },
    "RecurringExpense": {
      "title": "RecurringExpense",
      "description": "Standing order template to be imported monthly",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "amount": { "type": "number" },
        "jarId": { "type": "string" },
        "category": { "type": "string" },
        "dayOfMonth": { "type": "number" },
        "active": { "type": "boolean" },
        "lastExecutedMonth": { "type": "string" },
        "note": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "amount", "jarId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "entity": "User",
      "description": "User profile documents"
    },
    "/users/{userId}/jars/{jarId}": {
      "entity": "Jar",
      "description": "User's 7 budget jars"
    },
    "/users/{userId}/transactions/{txId}": {
      "entity": "Transaction",
      "description": "User's transactions and fund movements"
    },
    "/users/{userId}/recurring_expenses/{expenseId}": {
      "entity": "RecurringExpense",
      "description": "User's recurring monthly expenses and standing orders"
    }
  }
}
